// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User for authentication
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Settings for website customization
model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Guru (Teacher) Data
model Guru {
  id          String   @id @default(cuid())
  originalId  String?  // Original ID from CSV
  nama        String
  jk          String?  // Jenis Kelamin
  sekolah     String?
  alamat      String?
  nuptk       String?
  jenisTendik String?
  nik         String?
  nip         String?
  tempatLahir String?
  tanggalLahir String?
  umur        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Siswa (Student) Data
model Siswa {
  id          String   @id @default(cuid())
  originalId  String?  // Original ID from CSV
  nama        String
  jenjang     String?
  namaSekolah String?
  jk          String?  // Jenis Kelamin
  alamat      String?
  tempatLahir String?
  tanggalLahir String?
  nisn        String?
  nik         String?
  kelas       String?
  umur        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Posyandu Data
model Posyandu {
  id          String   @id @default(cuid())
  originalId  String?  // Original ID from CSV
  nama        String
  posyandu    String?
  alamat      String?
  kategori    String?
  jk          String?  // Jenis Kelamin
  nik         String?
  tempatLahir String?
  tanggalLahir String?
  umur        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Activity Log
model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  details   String?
  userId    String?
  createdAt DateTime @default(now())
}

// Export Settings for customizing export headers
model ExportSetting {
  id        String   @id @default(cuid())
  type      String   @unique // guru, siswa, posyandu, relawan
  headers   String   // JSON string of header configuration
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Relawan (Volunteer) Data
model Relawan {
  id          String   @id @default(cuid())
  originalId  String?  // Original ID from CSV
  nama        String
  divisi      String?
  jabatan     String?
  gajiPokok   String?
  jk          String?  // Jenis Kelamin
  nik         String?
  tempatLahir String?
  tanggalLahir String?
  umur        String?
  alamat      String?  // Alamat
  hariKerja   String?
  bonus       String?
  totalGaji   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  payroll     Payroll[]
}

// Payroll Record for tracking salary payments
model Payroll {
  id          String   @id @default(cuid())
  relawanId   String
  bulan       Int      // 1-12
  tahun       Int      // e.g., 2024
  gajiPokok   Int      @default(0)
  hariKerja   Int      @default(0)
  bonus       Int      @default(0)
  potongan    Int      @default(0)
  totalGaji   Int      @default(0)
  status      String   @default("pending") // pending, paid
  tanggalBayar DateTime?
  keterangan  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  relawan     Relawan  @relation(fields: [relawanId], references: [id])
}

// Distribusi Data
model Distribusi {
  id          String   @id @default(cuid())
  namaSekolah String
  
  // Siswa - TK/PAUD
  klsAL       Int      @default(0)
  klsAP       Int      @default(0)
  klsBL       Int      @default(0)
  klsBP       Int      @default(0)
  
  // Siswa - SD/MI
  kls1L       Int      @default(0)
  kls1P       Int      @default(0)
  kls2L       Int      @default(0)
  kls2P       Int      @default(0)
  kls3L       Int      @default(0)
  kls3P       Int      @default(0)
  kls4L       Int      @default(0)
  kls4P       Int      @default(0)
  kls5L       Int      @default(0)
  kls5P       Int      @default(0)
  kls6L       Int      @default(0)
  kls6P       Int      @default(0)
  
  // Siswa - SMP/MTs
  kls7L       Int      @default(0)
  kls7P       Int      @default(0)
  kls8L       Int      @default(0)
  kls8P       Int      @default(0)
  kls9L       Int      @default(0)
  kls9P       Int      @default(0)
  
  // Siswa - SMA/SMK/MA
  kls10L      Int      @default(0)
  kls10P      Int      @default(0)
  kls11L      Int      @default(0)
  kls11P      Int      @default(0)
  kls12L      Int      @default(0)
  kls12P      Int      @default(0)
  
  // Guru
  kepsekL     Int      @default(0)
  kepsekP     Int      @default(0)
  guruL       Int      @default(0)
  guruP       Int      @default(0)
  tendikL     Int      @default(0)
  tendikP     Int      @default(0)
  nonTendikL  Int      @default(0)
  nonTendikP  Int      @default(0)
  
  // Uji Organoleptik
  ujiOrganoleptik Int  @default(0)
  
  // Total & Date
  jumlah      Int
  tanggal     DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
