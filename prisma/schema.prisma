generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ActivityLog {
  id        String   @id
  action    String
  details   String?
  userId    String?
  createdAt DateTime @default(now())
}

model Barang {
  id              String            @id
  kode            String            @unique
  nama            String
  kategoriId      String?
  satuan          String
  stok            Int               @default(0)
  stokMin         Int               @default(0)
  harga           Int               @default(0)
  lokasi          String?
  keterangan      String?
  status          String            @default("aktif")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  BarangKategori  BarangKategori?   @relation(fields: [kategoriId], references: [id])
  BarangTransaksi BarangTransaksi[]

  @@index([status])
  @@index([nama])
  @@index([kode])
}

model BarangKategori {
  id        String   @id
  nama      String
  deskripsi String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  Barang    Barang[]

  @@index([nama])
}

model BarangTransaksi {
  id          String   @id
  barangId    String
  jenis       String
  jumlah      Int
  hargaSatuan Int      @default(0)
  totalHarga  Int      @default(0)
  tanggal     DateTime @default(now())
  keterangan  String?
  referensi   String?
  penerima    String?
  pengirim    String?
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  Barang      Barang   @relation(fields: [barangId], references: [id])

  @@index([tanggal])
  @@index([jenis])
  @@index([barangId])
}

model BeritaAcara {
  id           String   @id
  nomor        String
  tanggal      DateTime
  judul        String
  lokasi       String?
  peserta      String?
  uraian       String
  kesimpulan   String?
  tindakLanjut String?
  picNama      String?
  picJabatan   String?
  status       String   @default("draft")
  kategori     String?
  lampiran     String?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@index([kategori])
  @@index([status])
  @@index([tanggal])
}

model BeritaAcaraDistribusi {
  id              String   @id
  nomor           String
  tanggal         DateTime
  jam             String?
  namaSekolah     String
  jumlahPaket     Int
  kondisi         String?
  sppgNama        String?
  sppgInstansi    String?
  penerimaNama    String?
  penerimaJabatan String?
  keterangan      String?
  status          String   @default("draft")
  distribusiId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@index([status])
  @@index([namaSekolah])
  @@index([tanggal])
}

model Distribusi {
  id              String   @id
  namaSekolah     String
  klsAL           Int      @default(0)
  klsAP           Int      @default(0)
  klsBL           Int      @default(0)
  klsBP           Int      @default(0)
  kls1L           Int      @default(0)
  kls1P           Int      @default(0)
  kls2L           Int      @default(0)
  kls2P           Int      @default(0)
  kls3L           Int      @default(0)
  kls3P           Int      @default(0)
  kls4L           Int      @default(0)
  kls4P           Int      @default(0)
  kls5L           Int      @default(0)
  kls5P           Int      @default(0)
  kls6L           Int      @default(0)
  kls6P           Int      @default(0)
  kls7L           Int      @default(0)
  kls7P           Int      @default(0)
  kls8L           Int      @default(0)
  kls8P           Int      @default(0)
  kls9L           Int      @default(0)
  kls9P           Int      @default(0)
  kls10L          Int      @default(0)
  kls10P          Int      @default(0)
  kls11L          Int      @default(0)
  kls11P          Int      @default(0)
  kls12L          Int      @default(0)
  kls12P          Int      @default(0)
  kepsekL         Int      @default(0)
  kepsekP         Int      @default(0)
  guruL           Int      @default(0)
  guruP           Int      @default(0)
  tendikL         Int      @default(0)
  tendikP         Int      @default(0)
  nonTendikL      Int      @default(0)
  nonTendikP      Int      @default(0)
  ujiOrganoleptik Int      @default(0)
  jumlah          Int
  tanggal         DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime
}

model DistribusiPosyandu {
  id              String   @id @default(cuid())
  namaPosyandu    String   // Nama posyandu

  // Balita (0-5 tahun)
  balitaL         Int      @default(0) // Laki-laki
  balitaP         Int      @default(0) // Perempuan

  // Ibu Hamil
  bumilL          Int      @default(0) // (tidak dipakai, untuk konsistensi)
  bumilP          Int      @default(0) // Ibu hamil

  // Ibu Menyusui
  busuiL         Int      @default(0) // (tidak dipakai)
  busuiP         Int      @default(0) // Ibu menyusui

  // Lansia (60+ tahun)
  lansiaL        Int      @default(0) // Laki-laki
  lansiaP        Int      @default(0) // Perempuan

  // WUS (Wanita Usia Subur 15-49 tahun)
  wusL           Int      @default(0) // (tidak dipakai)
  wusP           Int      @default(0) // Wanita usia subur

  // Total & Date
  jumlah         Int      // Total penerima
  tanggal        DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([namaPosyandu])
  @@index([tanggal])
}

model ExportSetting {
  id        String   @id
  type      String   @unique
  headers   String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model FoodDiary {
  id        String   @id
  date      DateTime
  ageGroup  String
  foodId    Int
  foodName  String
  category  String
  amount    Int
  calories  Int
  protein   Float
  carbs     Float
  fat       Float
  fiber     Float
  mealType  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([ageGroup])
  @@index([date])
}

model Guru {
  id           String   @id
  originalId   String?
  nama         String
  jk           String?
  sekolah      String?
  alamat       String?
  nuptk        String?
  jenisTendik  String?
  nik          String?
  nip          String?
  tempatLahir  String?
  tanggalLahir String?
  umur         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model LaporanGudang {
  id             String   @id
  judul          String
  jenis          String
  periodeMulai   DateTime
  periodeSelesai DateTime
  data           String
  keterangan     String?
  status         String   @default("draft")
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime

  @@index([periodeMulai])
  @@index([status])
  @@index([jenis])
}

model Payroll {
  id             String    @id
  relawanId      String
  periode        Int
  tahun          Int
  tanggalMulai   DateTime
  tanggalSelesai DateTime
  gajiHarian     Int       @default(0)
  hariKerja      Int       @default(0)
  bonus          Int       @default(0)
  potongan       Int       @default(0)
  totalGaji      Int       @default(0)
  status         String    @default("pending")
  tanggalBayar   DateTime?
  keterangan     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  Relawan        Relawan   @relation(fields: [relawanId], references: [id])
}

model Posyandu {
  id           String   @id
  originalId   String?
  nama         String
  posyandu     String?
  alamat       String?
  kategori     String?
  jk           String?
  nik          String?
  tempatLahir  String?
  tanggalLahir String?
  umur         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model Relawan {
  id           String    @id
  originalId   String?
  nama         String
  divisi       String?
  jabatan      String?
  gajiPokok    String?
  jk           String?
  nik          String?
  tempatLahir  String?
  tanggalLahir String?
  umur         String?
  alamat       String?
  hariKerja    String?
  bonus        String?
  totalGaji    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  Payroll      Payroll[]
}

model Setting {
  id        String   @id
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Siswa {
  id           String   @id
  originalId   String?
  nama         String
  jenjang      String?
  namaSekolah  String?
  jk           String?
  alamat       String?
  tempatLahir  String?
  tanggalLahir String?
  nisn         String?
  nik          String?
  kelas        String?
  umur         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model User {
  id        String   @id
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime
}
